< SESSION=c3-racine-registre-$PHASE-$(date -u +%Y%m%d)
> RUN=/home/bruno/runs/c3_campagne_grid/campagne
> SESSION=c3-campagne-grid-$(date -u +%Y%m%d)
< log "# launch $PHASE — $(date -u +%FT%TZ) — sha $SHA"
> log "# launch — $(date -u +%FT%TZ) — sha $SHA"
