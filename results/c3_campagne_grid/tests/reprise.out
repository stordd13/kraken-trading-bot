< # --- une exécution ------------------------------------------------------------------------------------------------
< # step <clé> <journal> <entrées requises…> -- <arguments python…> : SKIPPED si une entrée manque, sinon le code.
< step() {
<   local key=$1 journal=$2
<   shift 2
<   local missing=""
<   while [ "$1" != "--" ]; do
<     if [ ! -f "$1" ]; then missing=1; fi
<     shift
<   done
<   shift
<   if [ -n "$missing" ]; then
<     record "$key=SKIPPED entree_absente"
<     fail=1
<     return
<   fi
<   pyrun "$@" > "$WORK/logs/$journal" 2>&1
<   local r=$?
<   record "$key=$r"
<   expect "$r" 0
< }
