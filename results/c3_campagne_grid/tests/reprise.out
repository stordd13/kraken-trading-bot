>   r=$?
>   ev="-"
>   if [ "$r" -ne 0 ]; then ev=$(event_of "$OUT/logs/prefix.log"); fi
>   record "prefix=$r event=$ev at=$(stamp)"
>   [ "$r" = "0" ] || deviate prefix
> else
>   record "prefix=NOT_RUN"
> fi
