# =============================================================================
# KrakenBot - Dev Local (.env template)
# =============================================================================
# cp .env.example .env && vim .env
# JAMAIS committer le .env !
#
# En production, le .env est genere automatiquement par GitHub Actions
# depuis les GitHub Secrets (voir .github/workflows/deploy.yml).
# Les params de strategie sont dans strategies.yaml (versionne).
# =============================================================================

# --- Exchange (OBLIGATOIRE, pas de default) ---
# kraken | binance | bybit — cible runtime (bot, collector, dashboard).
# Sans cette variable, Settings() refuse de demarrer (incident serveur 2026-09-07).
EXCHANGE_NAME=bybit

# --- Bybit EU API (cible depuis B1) ---
# Cles creees sur https://www.bybit.eu (instance separee : refusees sur api.bybit.com).
# Lecture seule pour paper ; permission Spot Trade + readOnly=0 pour live.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_HOSTNAME=bybit.eu
BYBIT_RECV_WINDOW=5000
BYBIT_ACCOUNT_TYPE=UNIFIED

# --- Binance API (legacy, hors UE depuis 2026-07-01) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Kraken API (legacy) ---
# https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Database ---
# docker-compose up -d pour lancer TimescaleDB local
DATABASE_URL=postgresql+asyncpg://krakenbot:krakenbot@localhost:5432/krakenbot

# --- Trading ---
TRADING_MODE=paper
TRADING_CONFIRM_LIVE=no
TRADING_PAIR=XBT/USDC
TRADING_DEFAULT_ORDER_AMOUNT_EUR=15.0
TRADING_CANDLE_INTERVAL_MIN=5

# --- Risk ---
RISK_MIN_TRADE_INTERVAL_SEC=60
RISK_EMERGENCY_STOP_LOSS_PCT=10.0

# --- Scheduler ---
SCHEDULER_ENABLED=true

# --- Telegram Notifications ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_JSON=false
