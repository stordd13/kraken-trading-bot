# =============================================================================
# KrakenBot - Dev Local (.env template)
# =============================================================================
# cp .env.example .env && vim .env
# JAMAIS committer le .env !
#
# En production, le .env est genere automatiquement par GitHub Actions
# depuis les GitHub Secrets (voir .github/workflows/deploy.yml).
# Les params de strategie sont dans strategies.yaml (versionne).
# =============================================================================

# --- Exchange (OBLIGATOIRE, pas de default) ---
# kraken | binance | bybit — cible runtime (bot, collector, dashboard).
# Sans cette variable, Settings() refuse de demarrer (incident serveur 2026-09-07).
EXCHANGE_NAME=bybit

# --- Bybit EU API (cible depuis B1) ---
# Cles creees sur https://www.bybit.eu (instance separee : refusees sur api.bybit.com).
# Deux paires de cles, deux roles :
#   BYBIT_API_KEY / BYBIT_API_SECRET             -> cle READ-ONLY (paper mode, lectures, audits)
#   BYBIT_TRADE_API_KEY / BYBIT_TRADE_API_SECRET -> cle TRADE (Spot Trade uniquement, JAMAIS withdraw),
#                                                   utilisee en TRADING_MODE=live et par --trade
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TRADE_API_KEY=
BYBIT_TRADE_API_SECRET=
BYBIT_HOSTNAME=bybit.eu
BYBIT_RECV_WINDOW=5000
BYBIT_ACCOUNT_TYPE=UNIFIED
# WebSocket public spot (B2). Les klines ne sont poussees que sur trade : le watchdog surveille
# le flux agrege (24 topics). warn -> re-subscribe silencieux ; zombie -> Telegram + reconnect.
BYBIT_WS_URL=wss://stream.bybit.eu/v5/public/spot
BYBIT_WS_PING_INTERVAL_SECONDS=20
BYBIT_WS_PONG_TIMEOUT_SECONDS=10
BYBIT_WS_WATCHDOG_WARN_SECONDS=600
BYBIT_WS_WATCHDOG_ZOMBIE_SECONDS=1800
BYBIT_WS_WATCHDOG_RESUBSCRIBE_ALERT_COUNT=3

# --- Binance API (legacy, hors UE depuis 2026-07-01) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Kraken API (legacy) ---
# https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Database ---
# docker-compose up -d pour lancer TimescaleDB local
DATABASE_URL=postgresql+asyncpg://krakenbot:krakenbot@localhost:5432/krakenbot

# --- Trading ---
TRADING_MODE=paper
TRADING_CONFIRM_LIVE=no
TRADING_PAIR=XBT/USDC
TRADING_DEFAULT_ORDER_AMOUNT_EUR=15.0
TRADING_CANDLE_INTERVAL_MIN=5

# --- Risk ---
RISK_MIN_TRADE_INTERVAL_SEC=60
RISK_EMERGENCY_STOP_LOSS_PCT=10.0

# --- Scheduler / collector ---
# Paires et timeframes collectes par le collector (WS). Le backfill REST du TaskScheduler
# est encore hardcode Kraken (dette B3) : il n'est instancie que si EXCHANGE_NAME=kraken.
SCHEDULER_ENABLED=true
SCHEDULER_PAIRS=["BTC/USDC","ETH/USDC","SOL/USDC"]
SCHEDULER_INTERVALS=[1,5,15,60,240,1440,10080]

# --- Telegram Notifications ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Logging ---
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LOG_JSON=false
