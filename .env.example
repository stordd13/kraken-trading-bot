# =============================================================================
# KrakenBot - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=KrakenBot
ENVIRONMENT=development  # development | production | testing
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=true            # true | false

# -----------------------------------------------------------------------------
# Kraken API Configuration
# -----------------------------------------------------------------------------
# Get your API keys from: https://www.kraken.com/u/security/api
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# API endpoints (usually no need to change)
KRAKEN_API_URL=https://api.kraken.com
KRAKEN_WS_URL=wss://ws.kraken.com

# WebSocket settings
KRAKEN_WS_RECONNECT_DELAY_SEC=5

# Rate limiting (Kraken allows ~15 calls/min for Tier 1)
KRAKEN_API_RATE_LIMIT_CALLS=15

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL + TimescaleDB connection string
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://krakenbot:krakenbot@localhost:5432/krakenbot

# Database connection pool settings
DATABASE_ECHO=false       # Set to true to see SQL queries (dev only)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Trading Configuration
# -----------------------------------------------------------------------------
# ⚠️ CRITICAL: ALWAYS start in paper mode!
TRADING_MODE=paper        # paper | live

# Trading pair
TRADING_PAIR=XBT/EUR

# Default order size (paper mode recommended: 15.0 EUR)
TRADING_DEFAULT_ORDER_AMOUNT_EUR=15.0

# Candle interval for analysis (in minutes)
TRADING_CANDLE_INTERVAL_MIN=15

# ⚠️ REQUIRED for live trading - explicit confirmation
# Set to "yes" ONLY when you're absolutely sure you want to trade with real money
TRADING_CONFIRM_LIVE=no

# -----------------------------------------------------------------------------
# Risk Management
# -----------------------------------------------------------------------------
# Maximum position size as percentage of total portfolio
RISK_MAX_POSITION_PCT=5.0

# Daily loss limit in EUR - trading stops if exceeded
RISK_DAILY_LOSS_LIMIT_EUR=50.0

# Maximum number of simultaneous open positions
RISK_MAX_OPEN_POSITIONS=3

# Minimum interval between trades (seconds)
RISK_MIN_TRADE_INTERVAL_SEC=60

# Emergency stop-loss percentage (absolute loss on position)
RISK_EMERGENCY_STOP_LOSS_PCT=10.0

# -----------------------------------------------------------------------------
# Strategy Configuration
# -----------------------------------------------------------------------------
# Active strategy name
STRATEGY_NAME=threshold

# Threshold Strategy Parameters
# Buy when price drops by this percentage
STRATEGY_BUY_THRESHOLD_PCT=-1.0

# Sell when price rises by this percentage from entry
STRATEGY_SELL_THRESHOLD_PCT=2.0

# Number of candles to analyze for decision making
STRATEGY_LOOKBACK_PERIODS=10

# =============================================================================
# Production Checklist
# =============================================================================
# Before switching to TRADING_MODE=live:
#
# ✅ Test extensively in paper mode
# ✅ Verify risk management settings are appropriate
# ✅ Set TRADING_CONFIRM_LIVE=yes
# ✅ Start with small TRADING_DEFAULT_ORDER_AMOUNT_EUR
# ✅ Monitor the first few trades closely
# ✅ Have a plan to stop the bot quickly if needed
# =============================================================================
