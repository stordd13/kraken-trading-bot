# Agent prompts and working docs (not part of the codebase)
ROADMAP_*.md
AGENTS.md
CODEX.md
.codexignore

# Raw data dumps (too large, not useful)
results/funding_history_*.json
# P6.7 determinism benchmark outputs (regenerated, see results/P6_7_multiprocessing_benchmark.md)
results/bench_*.json

# Claude Code local config
.claude/

# C1 A/B captures: grid A is 5+ MB gzipped, reproducible (sha256 in results/C1_metrics_report.md)
results/c1_ab/grid_A_*.json.gz
# C1 equity sidecars (--equity-out): reproducible, sha256 recorded in results/C1_metrics_report.md
results/c1_ab/*_equity.jsonl
# C2 A/B captures (same convention): grid A 3-year captures are 5+ MB gzipped, reproducible,
# sha256 recorded in results/C2_replay_report.md; equity sidecars likewise
results/c2_ab/grid_A_*.json.gz
results/c2_ab/*_equity.jsonl
# C2 pre-merge gate evidence: these are proof artifacts of the server determinism reruns,
# not runtime logs — the blanket `*.log` rule above would silently drop them (it did once).
!results/c2_replay/determinism_server/**/*.log
